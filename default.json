{
  "description": "Shareable Renovate config presets by AREA44",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    "abandonments:recommended",
    ":maintainLockFilesWeekly",
    "group:allNonMajor",
    ":semanticCommitTypeAll(chore)",
    ":automergeAll"
  ],
  "meteor": {
    "enabled": false
  },
  "labels": ["renovate"],
  "rangeStrategy": "bump",
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "commitMessageSuffix": "[SECURITY]"
  },
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "24 hours",
      "addLabels": ["node"],
      "schedule": ["before 5am on Saturday"]
    },
    {
      "matchDatasources": ["pypi"],
      "minimumReleaseAge": "24 hours",
      "addLabels": ["python"],
      "schedule": ["before 5am on Saturday"]
    },
    {
      "matchManagers": ["github-actions"],
      "schedule": [
        "after 2am and before 3am on Saturday"
      ]
    }
  ]
}
