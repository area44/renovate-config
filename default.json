{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shareable Renovate configuration presets by AREA44",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    "abandonments:recommended",
    ":maintainLockFilesWeekly",
    "group:allNonMajor",
    ":semanticCommitTypeAll(chore)"
  ],
  "meteor": {
    "enabled": false
  },
  "automerge": true,
  "labels": ["renovate"],
  "rangeStrategy": "bump",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "labels": ["renovate", "security"],
    "commitMessageSuffix": "[SECURITY]",
    "rangeStrategy": "update-lockfile"
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "addLabels": ["nodejs"],
      "schedule": ["before 5am on Sunday"]
    },
    {
      "matchManagers": ["pip", "poetry", "uv"],
      "addLabels": ["python"],
      "schedule": ["before 5am on Sunday"]
    },
    {
      "description": "Schedule GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"],
      "schedule": ["after 2am and before 6am on Sunday"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
